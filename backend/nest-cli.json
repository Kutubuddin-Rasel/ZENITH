{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "assets": [{ "include": "email/templates/**/*.hbs", "outDir": "dist" }],
    "watchAssets": true
  },
  "projects": {
    "main": {
      "type": "application",
      "root": ".",
      "entryFile": "main",
      "sourceRoot": "src"
    },
    "worker": {
      "type": "application",
      "root": ".",
      "entryFile": "worker.main",
      "sourceRoot": "src"
    }
  }
}